# =========================
# GPIO SECTION
# =========================

config MINDGROVE_HAVE_GPIO
    bool
    default y

config MINDGROVE_GPIO
    bool "GPIO Support"
    default n
    depends on MINDGROVE_HAVE_GPIO
    depends on DEV_GPIO


# =========================
# SPI SECTION
# =========================

config SPI_HWFEATURES
    bool "SPI Hardware Features"
    default n
    depends on SPI_DRIVER

config MINDGROVE_HAVE_SPI0
    bool
    default y

config MINDGROVE_SPI0
    bool "Enable SPI0"
    default y
    depends on MINDGROVE_HAVE_SPI0
    select MINDGROVE_SPI
    select SPI_DRIVER


