config MG_CLOCK_FREQUENCY
    int "Mindgrove Clock Frequency (Hz)"
    default 700000000
    help
        This defines the system clock frequency used by peripherals.

#
# Mindgrove Peripheral Configuration
#

comment "Mindgrove Peripheral Support"

# =========================
# UART SECTION
# =========================

config MINDGROVE_HAVE_UART0
    bool
    default y

config MINDGROVE_UART0
    bool "Enable UART0"
    default y
    depends on MINDGROVE_HAVE_UART0
    select UART0_SERIALDRIVER
    select ARCH_HAVE_SERIAL_TERMIOS
    select MINDGROVE_UART


config MINDGROVE_HAVE_UART1
    bool
    default y

config MINDGROVE_UART1
    bool "Enable UART1"
    default y
    depends on MINDGROVE_HAVE_UART1
    select UART1_SERIALDRIVER
    select ARCH_HAVE_SERIAL_TERMIOS
    select MINDGROVE_UART


config MINDGROVE_HAVE_UART2
    bool
    default y

config MINDGROVE_UART2
    bool "Enable UART2"
    default y
    depends on MINDGROVE_HAVE_UART2
    select UART2_SERIALDRIVER
    select ARCH_HAVE_SERIAL_TERMIOS
    select MINDGROVE_UART


config MINDGROVE_HAVE_UART3
    bool
    default y

config MINDGROVE_UART3
    bool "Enable UART3"
    default y
    depends on MINDGROVE_HAVE_UART3
    select UART3_SERIALDRIVER
    select ARCH_HAVE_SERIAL_TERMIOS
    select MINDGROVE_UART


config MINDGROVE_HAVE_UART4
