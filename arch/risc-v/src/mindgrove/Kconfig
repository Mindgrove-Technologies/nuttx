#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

# comment "Mindgrove Configuration Options"

# menu "Mindgrove Peripheral Support"

# # These "hidden" settings determine whether a peripheral option is available
# # for the selected MCU

config MINDGROVE_HAVE_UART0
	bool
	default y
	select UART0_SERIALDRIVER
	select ARCH_HAVE_SERIAL_TERMIOS

config MINDGROVE_UART0
	bool "UART0"
	default y
	select ARCH_HAVE_UART0
	select ARCH_HAVE_SERIAL_TERMIOS
	select MINDGROVE_UART

config MINDGROVE_HAVE_GPIO
    bool
    default y
    select DEV_GPIO

config MINDGROVE_GPIO
    bool "GPIO Support"
    default y
    depends on MINDGROVE_HAVE_GPIO
    select DEV_GPIO                   # NuttX GPIO framework
	depends on DEV_GPIO


# endmenu